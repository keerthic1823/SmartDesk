<%@ page import="com.smartdesk.model.Ticket,com.smartdesk.model.Comment,java.util.List" %><%@ page contentType="text/html;charset=UTF-8" %><%if(session.getAttribute("user")==null){response.sendRedirect("login.jsp");return;}Ticket t=(Ticket)request.getAttribute("ticket");List<Comment> comments=(List<Comment>)request.getAttribute("comments");%>
<!DOCTYPE html><html><head><title>SmartDesk | Ticket #<%=t.getTicketId()%></title><meta name="viewport" content="width=device-width,initial-scale=1"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="css/style.css" rel="stylesheet"></head>
<body><nav class="navbar navbar-sd navbar-dark"><div class="container"><a class="navbar-brand fw-bold" href="dashboard.jsp">SmartDesk</a></div></nav><div class="container py-4">
<a href="javascript:history.back()" class="btn btn-sm btn-light mb-3"><i class="bi bi-arrow-left"></i> Back</a><div class="row g-4"><div class="col-lg-8"><div class="sd-card p-4 p-md-5"><div class="d-flex justify-content-between gap-3"><div><span class="text-primary fw-semibold">INCIDENT #<%=t.getTicketId()%></span><h2 class="fw-bold mt-2"><%=t.getTitle()%></h2></div><span class="badge bg-primary badge-soft align-self-start"><%=t.getStatus()%></span></div><p class="text-muted mt-3"><%=t.getDescription()%></p><hr><div class="row g-4"><div class="col-6 col-md-3"><small class="text-muted">Category</small><div class="fw-semibold"><%=t.getCategory()%></div></div><div class="col-6 col-md-3"><small class="text-muted">Priority</small><div class="fw-semibold"><%=t.getPriority()%></div></div><div class="col-6 col-md-3"><small class="text-muted">Created by</small><div class="fw-semibold"><%=t.getCreatorName()%></div></div><div class="col-6 col-md-3"><small class="text-muted">Assigned to</small><div class="fw-semibold"><%=t.getAssigneeName()==null?"Unassigned":t.getAssigneeName()%></div></div></div></div>
<div class="sd-card p-4 mt-4"><h5 class="section-title mb-4">Conversation</h5><%if(comments!=null&&!comments.isEmpty())for(Comment c:comments){%><div class="d-flex gap-3 border-bottom pb-3 mb-3"><div class="icon-box flex-shrink-0"><i class="bi bi-person"></i></div><div><strong><%=c.getUserName()%></strong><small class="text-muted ms-2"><%=c.getCreatedAt()%></small><p class="mb-0 mt-1"><%=c.getComment()%></p></div></div><%}%><form method="post" action="AddCommentServlet"><input type="hidden" name="ticketId" value="<%=t.getTicketId()%>"><textarea class="form-control mb-2" name="comment" rows="3" placeholder="Write an update..." required></textarea><button class="btn btn-primary"><i class="bi bi-chat-left-text me-1"></i>Add Comment</button></form></div></div>
<div class="col-lg-4"><div class="sd-card p-4"><h5 class="section-title">Ticket timeline</h5><div class="timeline mt-4"><div class="timeline-item"><strong>Ticket created</strong><div class="small text-muted"><%=t.getCreatedAt()%></div></div><div class="timeline-item"><strong>Current status</strong><div class="small text-muted"><%=t.getStatus()%></div></div><div class="timeline-item"><strong>Last updated</strong><div class="small text-muted"><%=t.getUpdatedAt()%></div></div></div></div></div></div></div></body></html>
